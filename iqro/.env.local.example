# Asosiy URL va Supabase kalitlari
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Barcha env o'zgaruvchilari quyidagicha bo'lishi kerak:
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Telecom/Bot kalitlari
# Bu qatorni o'zingizning botingiz API tokeni bilan almashtiring
TELEGRAM_BOT_TOKEN=123456789:AABBccddeeFFgghhiiJJKKllmmnnoopp

# Vercel da ishlatish uchun:
# Ushbu barcha qiymatlarni Vercel loyihangizning 
# Settings -> Environment Variables qismiga qo'shing.

# Admin email/parol o'zgartirish uchun maxfiy so'z
ADMIN_SECRET_WORD=@Zuxriddin-bro@
